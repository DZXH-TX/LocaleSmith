<Page
    x:Class="JaxI18n.App.Pages.AssistantPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:JaxI18n.App.Behaviors"
    NavigationCacheMode="Required">
    <Grid Padding="24" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Uid="AssistantTitle" Style="{ThemeResource PageTitleStyle}" />
                <TextBlock x:Uid="AssistantSubtitle" TextWrapping="WrapWholeWords" />
            </StackPanel>
            <ComboBox
                Grid.Column="1"
                x:Uid="AssistantModelSelector"
                Width="280"
                ItemsSource="{Binding ModelSources}"
                SelectedItem="{Binding SelectedModelSource, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayName}" />
                            <TextBlock Style="{ThemeResource CaptionTextBlockStyle}">
                                <Run Text="{Binding ProviderName}" />
                                <Run Text=" · " />
                                <Run Text="{Binding ModelName}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar
                x:Uid="AssistantToolBoundary"
                behaviors:AppMotion.StatusFeedback="True"
                IsOpen="True"
                IsClosable="False"
                Severity="Warning" />
            <InfoBar
                x:Uid="AssistantError"
                behaviors:AppMotion.StatusFeedback="True"
                IsOpen="{Binding HasError}"
                IsClosable="False"
                Message="{Binding ErrorMessage}"
                Severity="Error" />
            <InfoBar
                x:Uid="AssistantStatus"
                behaviors:AppMotion.StatusFeedback="True"
                IsOpen="{Binding HasStatus}"
                IsClosable="False"
                Message="{Binding StatusMessage}"
                Severity="Informational" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Border Style="{ThemeResource CardBorderStyle}" Padding="8">
                <ListView
                    x:Name="ConversationList"
                    x:Uid="AssistantConversationList"
                    ItemsSource="{Binding Messages}"
                    SelectionMode="None"
                    IsItemClickEnabled="False"
                    AutomationProperties.LiveSetting="Polite">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="8,6"
                                Padding="16,12"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel Spacing="6">
                                    <TextBlock
                                        Text="{Binding RoleLabel}"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        Text="{Binding Content}"
                                        IsTextSelectionEnabled="True"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <StackPanel
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10"
                Visibility="{Binding IsConversationEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <FontIcon Glyph="&#xE99A;" FontSize="32" />
                <TextBlock
                    x:Uid="AssistantEmptyTitle"
                    Style="{ThemeResource SectionTitleStyle}"
                    TextAlignment="Center" />
                <TextBlock
                    x:Uid="AssistantEmptyBody"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Style="{ThemeResource CardBorderStyle}" Padding="16">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox
                    x:Uid="AssistantDraft"
                    AcceptsReturn="True"
                    MinHeight="96"
                    Text="{Binding Draft, Mode=TwoWay}"
                    TextWrapping="Wrap" />
                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{ThemeResource CaptionTextBlockStyle}">
                        <Run Text="{Binding DraftLength}" />
                        <Run x:Uid="AssistantLengthSuffix" />
                    </TextBlock>
                    <Button
                        Grid.Column="1"
                        x:Uid="AssistantClearButton"
                        Command="{Binding ClearCommand}" />
                    <Button
                        Grid.Column="2"
                        x:Uid="AssistantCancelButton"
                        Command="{Binding CancelCommand}" />
                    <Button
                        Grid.Column="3"
                        x:Uid="AssistantSendButton"
                        behaviors:AppMotion.ButtonFeedback="True"
                        Command="{Binding SendCommand}"
                        Style="{ThemeResource AccentButtonStyle}">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Enter" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
