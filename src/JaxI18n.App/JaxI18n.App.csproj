<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>JaxI18n.App</RootNamespace>
    <AssemblyName>JaxI18n.App</AssemblyName>
    <AssemblyTitle>LocaleSmith（译匠）</AssemblyTitle>
    <Product>LocaleSmith（译匠）</Product>
    <Description>LocaleSmith（译匠）— Minecraft 模组与资源包本地化工作台</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKBootstrapAutoInitializeOptions_OnPackageIdentity_NoOp>true</WindowsAppSDKBootstrapAutoInitializeOptions_OnPackageIdentity_NoOp>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <NativeCoreDll>$(MSBuildThisFileDirectory)..\..\native\jax_i18n_core\target\release\jax_i18n_core.dll</NativeCoreDll>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JaxI18n.Application\JaxI18n.Application.csproj" />
    <ProjectReference Include="..\JaxI18n.Archive\JaxI18n.Archive.csproj" />
    <ProjectReference Include="..\JaxI18n.Core\JaxI18n.Core.csproj" />
    <ProjectReference Include="..\JaxI18n.Infrastructure\JaxI18n.Infrastructure.csproj" />
    <ProjectReference Include="..\JaxI18n.Mcp\JaxI18n.Mcp.csproj" />
    <ProjectReference Include="..\JaxI18n.NativeInterop\JaxI18n.NativeInterop.csproj" />
    <ProjectReference Include="..\JaxI18n.Presentation\JaxI18n.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(NativeCoreDll)')">
    <None Include="$(NativeCoreDll)" Link="jax_i18n_core.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="EnsureNativeCoreExists" BeforeTargets="Build" Condition="!Exists('$(NativeCoreDll)')">
    <Error Text="The x64 Rust native core is missing. Run 'cargo build --manifest-path native/jax_i18n_core/Cargo.toml --release' before building JaxI18n.App." />
  </Target>
</Project>
