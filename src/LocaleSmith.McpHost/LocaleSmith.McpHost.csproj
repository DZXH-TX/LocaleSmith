<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LocaleSmith.McpHost</RootNamespace>
    <AssemblyName>LocaleSmith.McpHost</AssemblyName>
    <AssemblyTitle>LocaleSmith MCP Host</AssemblyTitle>
    <Product>LocaleSmith</Product>
    <Description>Standalone Windows x64 stdio MCP host exposing only bounded system.context and non-executing cli.propose; no project/file tools or command execution.</Description>
    <!-- Independent MCP package SemVer. Publish workflow inputs/tags must match this value. -->
    <Version>0.1.1</Version>
    <!-- Keep AssemblyVersion stable across compatible 0.1.x releases; FileVersion tracks the package release. -->
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.1.0</FileVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>localesmith-mcp</ToolCommandName>
    <PackageId>CRTech.LocaleSmith.McpHost</PackageId>
    <Title>LocaleSmith MCP Host</Title>
    <Authors>DZXH-TX</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/DZXH-TX/LocaleSmith</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DZXH-TX/LocaleSmith</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>localesmith;minecraft;localization;mcp;model-context-protocol;dotnet-tool;windows</PackageTags>
    <PackageReleaseNotes>0.1.1 synchronizes the standalone host with LocaleSmith 1.2.0 protocol validation and shared safety hardening. The standalone tool catalog remains limited to system.context and cli.propose. See https://github.com/DZXH-TX/LocaleSmith/tags.</PackageReleaseNotes>
    <Copyright>Copyright © 2026 DZXH-TX（道泽星河-天仙）</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocaleSmith.Infrastructure\LocaleSmith.Infrastructure.csproj" />
    <ProjectReference Include="..\LocaleSmith.Mcp\LocaleSmith.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\.github\package-readmes\LocaleSmith.McpHost.md"
          Pack="true"
          PackagePath="README.md" />
    <None Include="..\..\packaging\LocaleSmith.Package\Assets\Square150x150Logo.png"
          Pack="true"
          PackagePath="icon.png" />
  </ItemGroup>
</Project>
