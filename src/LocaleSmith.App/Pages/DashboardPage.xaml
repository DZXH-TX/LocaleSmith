<Page
    x:Class="LocaleSmith.App.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:LocaleSmith.App.Behaviors"
    NavigationCacheMode="Required">
    <Page.Resources>
        <!--
            Keep the first-realization path deliberately small. The previous card combined a
            virtualized item, Expander, adaptive visual states, a nested timeline and animated
            controls; WinUI failed inside native MeasureOverride before the backend scan began.
        -->
        <DataTemplate x:Key="StableQueueItemTemplate">
            <Border
                Margin="0,0,0,12"
                Padding="20"
                HorizontalAlignment="Stretch"
                Style="{ThemeResource CardBorderStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="{Binding FileName}"
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{Binding Loader}" />
                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{Binding ModId}" />
                            </StackPanel>
                        </StackPanel>
                        <Button
                            x:Uid="CancelQueueItemButton"
                            Grid.Column="1"
                            AutomationProperties.Name="{Binding CancelAccessibleName}"
                            Click="OnCancelQueueItemClicked"
                            IsEnabled="{Binding CanCancel}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE711;" FontSize="14" />
                                <TextBlock x:Uid="CancelQueueItemButtonText" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock
                        Grid.Row="1"
                        AutomationProperties.LiveSetting="Polite"
                        Text="{Binding Status}"
                        TextWrapping="WrapWholeWords" />
                    <Grid Grid.Row="2" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Maximum="1" Value="{Binding Progress}" />
                        <TextBlock Grid.Column="1" Text="{Binding ProgressText}" />
                    </Grid>
                    <StackPanel Grid.Row="3" Spacing="4">
                        <TextBlock Text="{Binding CurrentAction}" TextWrapping="WrapWholeWords" />
                        <TextBlock
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{Binding NextAction}"
                            TextWrapping="WrapWholeWords"
                            Visibility="{Binding HasNextAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding TranslationProfile}" TextWrapping="WrapWholeWords" />
                        <TextBlock Text="{Binding ArtifactStatus}" TextWrapping="WrapWholeWords" />
                        <TextBlock
                            Text="{Binding ModelUsageSummary}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            TextWrapping="WrapWholeWords"
                            Visibility="{Binding HasModelUsage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Row="4"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{Binding ErrorDetails}"
                        TextWrapping="WrapWholeWords"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock
                        Grid.Row="5"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding HardcodedSummary}"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Grid.Row="6"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding StageDetailsSummary}"
                        TextWrapping="WrapWholeWords"
                        Visibility="{Binding HasStageDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock
                        Grid.Row="7"
                        Text="{Binding RollbackStatusText}"
                        TextWrapping="WrapWholeWords"
                        Visibility="{Binding HasRollbackStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock
                        Grid.Row="8"
                        FontFamily="Consolas"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding TechnicalErrorDetails}"
                        TextWrapping="WrapWholeWords"
                        Visibility="{Binding HasTechnicalErrorDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>
    <Grid Padding="24" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="4">
                <TextBlock
                    x:Uid="DashboardTitle"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{ThemeResource PageTitleStyle}" />
                <TextBlock x:Uid="DashboardSubtitle" TextWrapping="WrapWholeWords" />
            </StackPanel>
            <StackPanel
                Grid.Row="1"
                MaxWidth="560"
                HorizontalAlignment="Stretch"
                Spacing="4">
                <ComboBox
                    x:Uid="DashboardModelSelector"
                    HorizontalAlignment="Stretch"
                    IsEnabled="{Binding HasModelSources}"
                    ItemsSource="{Binding ModelSources}"
                    SelectedValue="{Binding SelectedModelSourceId, Mode=TwoWay}"
                    SelectedValuePath="Id"
                    AutomationProperties.LiveSetting="Polite">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel AutomationProperties.Name="{Binding AccessibleLabel}">
                                <TextBlock Text="{Binding DisplayName}" />
                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}">
                                    <Run Text="{Binding ProviderName}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding ModelName}" />
                                    <Run Text=" · " />
                                    <Run x:Uid="ConfiguredStatusRun" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock
                    x:Uid="DashboardNoModelSources"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{Binding EmptyModelSourcesMessage}"
                    TextWrapping="WrapWholeWords"
                    Visibility="{Binding HasModelSources, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
                <ComboBox
                    x:Uid="DashboardTargetLanguageSelector"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding TargetLanguages}"
                    SelectedItem="{Binding SelectedTargetLanguage, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel AutomationProperties.Name="{Binding AccessibleLabel}">
                                <TextBlock Text="{Binding DisplayName}" />
                                <TextBlock
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{Binding DetailText}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock
                    x:Uid="DashboardTargetLanguageHelp"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    TextWrapping="WrapWholeWords" />
                <ComboBox
                    x:Uid="DashboardStyleSelector"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding TranslationStyles}"
                    SelectedItem="{Binding SelectedTranslationStyle, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" />
                                <TextBlock
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{Binding Description}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,20,0,16" Spacing="12">
            <Grid MaxWidth="420" HorizontalAlignment="Left" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    behaviors:AppMotion.ButtonFeedback="True"
                    HorizontalAlignment="Stretch"
                    Click="OnAddPackagesClicked"
                    IsEnabled="{Binding CanEnqueuePackages}"
                    Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" />
                        <TextBlock x:Uid="AddPackageButtonText" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Click="OnAddFolderClicked"
                    IsEnabled="{Binding CanEnqueuePackages}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" />
                        <TextBlock x:Uid="AddFolderButtonText" />
                    </StackPanel>
                </Button>
            </Grid>
            <InfoBar
                x:Uid="DashboardError"
                behaviors:AppMotion.StatusFeedback="True"
                IsOpen="{Binding HasError}"
                IsClosable="False"
                Message="{Binding ErrorMessage}"
                Severity="Error" />
            <InfoBar
                x:Uid="DashboardStatus"
                behaviors:AppMotion.StatusFeedback="True"
                IsOpen="{Binding HasStatus}"
                IsClosable="False"
                Message="{Binding StatusMessage}"
                Severity="Informational" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Border
                behaviors:AppMotion.Reveal="True"
                Padding="32"
                Style="{ThemeResource CardBorderStyle}"
                Visibility="{Binding IsQueueEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <FontIcon Glyph="&#xE8B7;" FontSize="32" />
                    <TextBlock x:Uid="QueueEmptyTitle" Style="{ThemeResource SectionTitleStyle}" TextAlignment="Center" />
                    <TextBlock x:Uid="QueueEmptyBody" TextAlignment="Center" TextWrapping="WrapWholeWords" />
                    <Button
                        x:Uid="QueueEmptyAddButton"
                        behaviors:AppMotion.ButtonFeedback="True"
                        HorizontalAlignment="Center"
                        Click="OnAddPackagesClicked"
                        IsEnabled="{Binding CanEnqueuePackages}"
                        Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>
            </Border>

            <!-- ItemsRepeater virtualizes the lightweight cards without ListViewItemPresenter. -->
            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                Visibility="{Binding IsQueueEmpty, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                <ItemsRepeater
                    x:Name="QueueList"
                    x:Uid="QueueList"
                    ItemTemplate="{StaticResource StableQueueItemTemplate}"
                    ItemsSource="{Binding QueueItems}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="12" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
