<Page
    x:Class="LocaleSmith.App.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:LocaleSmith.App.Behaviors"
    NavigationCacheMode="Required">
    <Grid Padding="24" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Uid="DashboardTitle" Style="{ThemeResource PageTitleStyle}" />
                <TextBlock x:Uid="DashboardSubtitle" TextWrapping="WrapWholeWords" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Width="280"
                Spacing="4">
                <ComboBox
                    x:Uid="DashboardModelSelector"
                    Width="280"
                    IsEnabled="{Binding HasModelSources}"
                    ItemsSource="{Binding ModelSources}"
                    SelectedValue="{Binding SelectedModelSourceId, Mode=TwoWay}"
                    SelectedValuePath="Id"
                    AutomationProperties.LiveSetting="Polite">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel AutomationProperties.Name="{Binding AccessibleLabel}">
                                <TextBlock Text="{Binding DisplayName}" />
                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}">
                                    <Run Text="{Binding ProviderName}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding ModelName}" />
                                    <Run Text=" · " />
                                    <Run x:Uid="ConfiguredStatusRun" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock
                    x:Uid="DashboardNoModelSources"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{Binding EmptyModelSourcesMessage}"
                    TextWrapping="WrapWholeWords"
                    Visibility="{Binding HasModelSources, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
                <ComboBox
                    x:Uid="DashboardStyleSelector"
                    Width="280"
                    ItemsSource="{Binding TranslationStyles}"
                    SelectedItem="{Binding SelectedTranslationStyle, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" />
                                <TextBlock
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{Binding Description}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,20,0,16" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    behaviors:AppMotion.ButtonFeedback="True"
                    Click="OnAddPackagesClicked"
                    IsEnabled="{Binding CanEnqueuePackages}"
                    Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" />
                        <TextBlock x:Uid="AddPackageButtonText" />
                    </StackPanel>
                </Button>
                <Button Click="OnAddFolderClicked" IsEnabled="{Binding CanEnqueuePackages}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" />
                        <TextBlock x:Uid="AddFolderButtonText" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <InfoBar
                x:Uid="DashboardError"
                behaviors:AppMotion.StatusFeedback="True"
                IsOpen="{Binding HasError}"
                IsClosable="False"
                Message="{Binding ErrorMessage}"
                Severity="Error" />
            <InfoBar
                x:Uid="DashboardStatus"
                behaviors:AppMotion.StatusFeedback="True"
                IsOpen="{Binding HasStatus}"
                IsClosable="False"
                Message="{Binding StatusMessage}"
                Severity="Informational" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Border
                behaviors:AppMotion.Reveal="True"
                Padding="32"
                Style="{ThemeResource CardBorderStyle}"
                Visibility="{Binding IsQueueEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <FontIcon Glyph="&#xE8B7;" FontSize="32" />
                    <TextBlock x:Uid="QueueEmptyTitle" Style="{ThemeResource SectionTitleStyle}" TextAlignment="Center" />
                    <TextBlock x:Uid="QueueEmptyBody" TextAlignment="Center" TextWrapping="WrapWholeWords" />
                    <Button
                        x:Uid="QueueEmptyAddButton"
                        behaviors:AppMotion.ButtonFeedback="True"
                        HorizontalAlignment="Center"
                        Click="OnAddPackagesClicked"
                        IsEnabled="{Binding CanEnqueuePackages}"
                        Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>
            </Border>

            <ListView
                x:Name="QueueList"
                x:Uid="QueueList"
                ItemsSource="{Binding QueueItems}"
                SelectionMode="None"
                Visibility="{Binding IsQueueEmpty, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,12"
                            Padding="0"
                            Style="{ThemeResource CardBorderStyle}">
                            <Grid>
                                <Expander
                                    x:Uid="QueueDetailsExpander"
                                    behaviors:AppMotion.ExpandFeedback="True"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.Name="{Binding FileName}"
                                    IsExpanded="{Binding IsDetailsExpanded, Mode=TwoWay}">
                                    <Expander.Header>
                                        <Grid Padding="24,20" RowSpacing="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Margin="0,0,176,0">
                                                <TextBlock
                                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                    Text="{Binding FileName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    TextWrapping="WrapWholeWords">
                                                    <Run Text="{Binding Loader}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding ModId}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Row="1"
                                                AutomationProperties.LiveSetting="Polite"
                                                Text="{Binding Status}"
                                                TextWrapping="WrapWholeWords" />
                                            <Grid Grid.Row="2" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Maximum="1" Value="{Binding Progress}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontFamily="Cascadia Mono, Consolas"
                                                    Text="{Binding ProgressText}" />
                                            </Grid>
                                            <StackPanel Grid.Row="3" Spacing="6">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="12" />
                                                    <TextBlock Text="{Binding TranslationStyleName}" />
                                                    <TextBlock Text="{Binding ArtifactStatus}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    TextWrapping="WrapWholeWords">
                                                    <Run x:Uid="HardcodedFoundPrefix" />
                                                    <Run Text="{Binding HardcodedCandidateCount}" />
                                                    <Run x:Uid="HardcodedExternalizedPrefix" />
                                                    <Run Text="{Binding ExternalizedCount}" />
                                                    <Run x:Uid="HardcodedReadonlySuffix" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Margin="24,0,24,24" Spacing="16">
                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                        <Grid x:Name="QueueActionGrid" ColumnSpacing="12" RowSpacing="12">
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup>
                                                    <VisualState x:Name="NarrowQueueActions">
                                                        <VisualState.StateTriggers>
                                                            <AdaptiveTrigger MinWindowWidth="0" />
                                                        </VisualState.StateTriggers>
                                                        <VisualState.Setters>
                                                            <Setter Target="CurrentActionPanel.(Grid.ColumnSpan)" Value="2" />
                                                            <Setter Target="NextActionPanel.(Grid.Row)" Value="1" />
                                                            <Setter Target="NextActionPanel.(Grid.Column)" Value="0" />
                                                            <Setter Target="NextActionPanel.(Grid.ColumnSpan)" Value="2" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="WideQueueActions">
                                                        <VisualState.StateTriggers>
                                                            <AdaptiveTrigger MinWindowWidth="720" />
                                                        </VisualState.StateTriggers>
                                                        <VisualState.Setters>
                                                            <Setter Target="CurrentActionPanel.(Grid.ColumnSpan)" Value="1" />
                                                            <Setter Target="NextActionPanel.(Grid.Row)" Value="0" />
                                                            <Setter Target="NextActionPanel.(Grid.Column)" Value="1" />
                                                            <Setter Target="NextActionPanel.(Grid.ColumnSpan)" Value="1" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border
                                                x:Name="CurrentActionPanel"
                                                Grid.ColumnSpan="2"
                                                Padding="14"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                                <StackPanel Spacing="4">
                                                    <TextBlock
                                                        x:Uid="QueueCurrentActionLabel"
                                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                                    <TextBlock
                                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                        Text="{Binding CurrentAction}"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                            </Border>
                                            <Border
                                                x:Name="NextActionPanel"
                                                Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                Padding="14"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                                <StackPanel Spacing="4">
                                                    <TextBlock
                                                        x:Uid="QueueNextActionLabel"
                                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                                    <TextBlock
                                                        Text="{Binding NextAction}"
                                                        TextWrapping="WrapWholeWords"
                                                        Visibility="{Binding HasNextAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <TextBlock
                                                        x:Uid="QueueNoNextAction"
                                                        TextWrapping="WrapWholeWords"
                                                        Visibility="{Binding HasNextAction, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <StackPanel Spacing="10">
                                            <TextBlock x:Uid="QueueTimelineTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <ItemsControl
                                                x:Uid="QueueTimeline"
                                                ItemsSource="{Binding StageDetails}"
                                                Visibility="{Binding HasStageDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Padding="4,6" ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="24" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid
                                                                Width="24"
                                                                Height="24"
                                                                AutomationProperties.AccessibilityView="Raw">
                                                                <ProgressRing
                                                                    Width="20"
                                                                    Height="20"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    IsActive="{Binding IsCurrent}"
                                                                    Visibility="{Binding IsCurrent, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <FontIcon
                                                                    Glyph="&#xE73E;"
                                                                    FontSize="16"
                                                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                                    Visibility="{Binding IsCompleted, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <FontIcon
                                                                    Glyph="&#xE783;"
                                                                    FontSize="16"
                                                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                    Visibility="{Binding IsFailed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <FontIcon
                                                                    Glyph="&#xE711;"
                                                                    FontSize="16"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Visibility="{Binding IsCancelled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <FontIcon
                                                                    Glyph="&#xE72A;"
                                                                    FontSize="16"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Visibility="{Binding IsSkipped, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <FontIcon
                                                                    Glyph="&#xE823;"
                                                                    FontSize="16"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Visibility="{Binding IsPending, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            </Grid>
                                                            <StackPanel Grid.Column="1" Spacing="2">
                                                                <TextBlock
                                                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                                    Text="{Binding StageName}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                                    Text="{Binding StatusText}"
                                                                    TextWrapping="WrapWholeWords" />
                                                                <TextBlock
                                                                    FontFamily="Cascadia Mono, Consolas"
                                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                                    Text="{Binding TimingText}"
                                                                    TextWrapping="WrapWholeWords"
                                                                    Visibility="{Binding HasTiming, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Text="{Binding DetailsEmptyMessage}"
                                                TextWrapping="WrapWholeWords"
                                                Visibility="{Binding HasStageDetails, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
                                        </StackPanel>

                                        <StackPanel
                                            Spacing="10"
                                            Visibility="{Binding HasFailureDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock x:Uid="QueueFailureDetailsTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <InfoBar
                                                behaviors:AppMotion.StatusFeedback="True"
                                                IsOpen="{Binding HasError}"
                                                IsClosable="False"
                                                Message="{Binding ErrorDetails}"
                                                Severity="Error" />
                                            <Border
                                                Padding="12"
                                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                CornerRadius="8"
                                                Visibility="{Binding HasRollbackStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE7A7;" FontSize="16" />
                                                    <TextBlock
                                                        Text="{Binding RollbackStatusText}"
                                                        TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                            </Border>
                                            <StackPanel
                                                Spacing="6"
                                                Visibility="{Binding HasTechnicalErrorDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock x:Uid="QueueTechnicalDetailsTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                                <TextBox
                                                    AcceptsReturn="True"
                                                    IsReadOnly="True"
                                                    Style="{ThemeResource MonospaceTextBoxStyle}"
                                                    Text="{Binding TechnicalErrorDetails}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                                <Button
                                    x:Uid="CancelQueueItemButton"
                                    behaviors:AppMotion.ButtonFeedback="True"
                                    Margin="0,22,64,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Canvas.ZIndex="1"
                                    Click="OnCancelQueueItemClicked"
                                    IsEnabled="{Binding CanCancel}">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="18" Height="18">
                                            <FontIcon
                                                Glyph="&#xE711;"
                                                FontSize="14"
                                                Visibility="{Binding IsCancellationRequested, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
                                            <ProgressRing
                                                Width="16"
                                                Height="16"
                                                IsActive="{Binding IsCancellationRequested}"
                                                Visibility="{Binding IsCancellationRequested, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                        <TextBlock
                                            x:Uid="CancelQueueItemButtonText"
                                            Grid.Column="1" />
                                    </Grid>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
