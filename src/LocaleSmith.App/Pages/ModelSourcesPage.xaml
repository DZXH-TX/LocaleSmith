<Page
    x:Class="LocaleSmith.App.Pages.ModelSourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:LocaleSmith.App.Behaviors"
    NavigationCacheMode="Required">
    <Grid Padding="24" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" ColumnSpacing="24">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SourceListPane.Visibility" Value="Collapsed" />
                        <Setter Target="EditorPane.(Grid.Column)" Value="0" />
                        <Setter Target="EditorPane.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="CompactSourceSelector.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SourceListPane.Visibility" Value="Visible" />
                        <Setter Target="EditorPane.(Grid.Column)" Value="1" />
                        <Setter Target="EditorPane.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="CompactSourceSelector.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="SourceListPane" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="ModelSourcesTitle" Style="{ThemeResource PageTitleStyle}" />
                <Button Grid.Column="1" Command="{Binding NewCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" />
                        <TextBlock x:Uid="NewModelSourceButtonText" />
                    </StackPanel>
                </Button>
            </Grid>
            <ListView
                Grid.Row="1"
                x:Uid="ModelSourcesList"
                ItemsSource="{Binding Sources}"
                SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="4" Spacing="2">
                            <TextBlock Text="{Binding DisplayName}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{Binding ProviderName}" Style="{ThemeResource CaptionTextBlockStyle}" />
                            <TextBlock Text="{Binding ModelName}" Style="{ThemeResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <ScrollViewer x:Name="EditorPane" Grid.Column="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" Spacing="16">
                <TextBlock x:Uid="ModelSourceEditorTitle" Style="{ThemeResource PageTitleStyle}" />
                <ComboBox
                    x:Name="CompactSourceSelector"
                    x:Uid="CompactModelSourcesSelector"
                    ItemsSource="{Binding Sources}"
                    SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                    DisplayMemberPath="DisplayName"
                    Visibility="Collapsed" />
                <InfoBar
                    x:Uid="ProviderChangeWarning"
                    behaviors:AppMotion.StatusFeedback="True"
                    IsOpen="{Binding HasPendingProviderChange}"
                    IsClosable="False"
                    Severity="Warning" />
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{Binding HasPendingProviderChange, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button x:Uid="KeepProviderButton" Command="{Binding CancelProviderChangeCommand}" />
                    <Button x:Uid="ApplyProviderButton" Command="{Binding ConfirmProviderChangeCommand}" />
                </StackPanel>
                <InfoBar
                    x:Uid="ModelSourceError"
                    behaviors:AppMotion.StatusFeedback="True"
                    IsOpen="{Binding HasError}"
                    IsClosable="False"
                    Message="{Binding ErrorMessage}"
                    Severity="Error" />
                <InfoBar
                    x:Uid="ModelSourceStatus"
                    behaviors:AppMotion.StatusFeedback="True"
                    IsOpen="{Binding HasStatus}"
                    IsClosable="False"
                    Message="{Binding StatusMessage}"
                    Severity="Success" />

                <TextBox
                    x:Uid="ModelSourceDisplayName"
                    Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox
                    x:Uid="ModelSourceProvider"
                    ItemsSource="{Binding ProviderOptions}"
                    SelectedItem="{Binding Provider, Mode=TwoWay}" />
                <StackPanel
                    Spacing="6"
                    Visibility="{Binding IsOpenAiCompatible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ComboBox
                        x:Uid="ModelSourcePreset"
                        ItemsSource="{Binding PresetOptions}"
                        SelectedItem="{Binding SelectedPreset, Mode=OneWay}"
                        SelectionChanged="OnPresetSelectionChanged"
                        DisplayMemberPath="DisplayName" />
                    <TextBlock
                        Text="{Binding PresetEndpointHint}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        TextWrapping="WrapWholeWords" />
                    <HyperlinkButton
                        x:Uid="ModelSourcePresetDocumentation"
                        HorizontalAlignment="Left"
                        NavigateUri="{Binding PresetDocumentationUri}"
                        Visibility="{Binding HasPresetDocumentation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ComboBox
                        x:Uid="ModelSourceTokenLimitParameter"
                        ItemsSource="{Binding TokenLimitParameterOptions}"
                        DisplayMemberPath="DisplayName"
                        SelectedItem="{Binding SelectedTokenLimitParameterOption, Mode=OneWay}"
                        SelectionChanged="OnTokenLimitParameterSelectionChanged" />
                    <TextBlock
                        x:Uid="ModelSourceTokenLimitParameterHelp"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
                <TextBox
                    x:Uid="ModelSourceEndpoint"
                    Text="{Binding Endpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    x:Uid="ModelSourceModelName"
                    Text="{Binding ModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Border
                    Style="{ThemeResource CardBorderStyle}"
                    Visibility="{Binding IsOllama, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="DownloadedModelsTitle" Style="{ThemeResource SectionTitleStyle}" />
                            <Button Grid.Column="1" Command="{Binding RefreshModelsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" />
                                    <TextBlock x:Uid="RefreshModelsButtonText" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ComboBox
                            x:Uid="DownloadedModelsSelector"
                            ItemsSource="{Binding AvailableModels}"
                            SelectedItem="{Binding SelectedAvailableModel, Mode=TwoWay}"
                            DisplayMemberPath="Name" />
                        <TextBlock x:Uid="DownloadedModelsHelp" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Border>

                <StackPanel
                    Spacing="8"
                    Visibility="{Binding IsApiKeyRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <PasswordBox
                        x:Name="ApiKeyInput"
                        x:Uid="ModelSourceApiKey"
                        PasswordRevealMode="Peek" />
                    <TextBlock>
                        <Run x:Uid="CredentialAliasPrefix" />
                        <Run Text="{Binding CredentialReference}" />
                    </TextBlock>
                </StackPanel>

                <InfoBar
                    x:Uid="ConnectionStatus"
                    behaviors:AppMotion.StatusFeedback="True"
                    IsOpen="{Binding HasNonErrorConnectionMessage}"
                    IsClosable="False"
                    Message="{Binding ConnectionMessage}" />
                <InfoBar
                    x:Uid="ConnectionErrorStatus"
                    behaviors:AppMotion.StatusFeedback="True"
                    IsOpen="{Binding IsConnectionFailure}"
                    IsClosable="False"
                    Message="{Binding ConnectionMessage}"
                    Severity="Error" />
                <ProgressBar
                    behaviors:AppMotion.Reveal="True"
                    IsIndeterminate="True"
                    Visibility="{Binding IsTestingConnection, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button Click="OnDeleteClicked" IsEnabled="{Binding HasSelectedSource}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" />
                            <TextBlock x:Uid="DeleteModelSourceButtonText" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Row="1"
                        x:Uid="TestConnectionButton"
                        Command="{Binding TestConnectionCommand}"
                        CommandParameter="{Binding Password, ElementName=ApiKeyInput}" />
                    <Button
                        Grid.Row="1"
                        Grid.Column="1"
                        x:Uid="SaveModelSourceButton"
                        behaviors:AppMotion.ButtonFeedback="True"
                        Command="{Binding SaveCommand}"
                        CommandParameter="{Binding Password, ElementName=ApiKeyInput}"
                        Style="{ThemeResource AccentButtonStyle}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <ContentDialog
            x:Name="DeleteDialog"
            x:Uid="DeleteModelSourceDialog"
            DefaultButton="Close" />
    </Grid>
</Page>
