<Page
    x:Class="LocaleSmith.App.Pages.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:LocaleSmith.App.Converters"
    NavigationCacheMode="Required">
    <Page.Resources>
        <converters:TranslationLogViewModeDisplayConverter x:Key="TranslationLogViewModeDisplayConverter" />
    </Page.Resources>
    <Grid
        Padding="24"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock
                x:Uid="LogsTitle"
                AutomationProperties.HeadingLevel="Level1"
                Style="{ThemeResource PageTitleStyle}" />
            <TextBlock x:Uid="LogsSubtitle" TextWrapping="WrapWholeWords" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Padding="16"
            Style="{ThemeResource CardBorderStyle}">
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ComboBox
                    x:Uid="LogsSessionSelector"
                    Grid.ColumnSpan="2"
                    DisplayMemberPath="DisplayName"
                    IsEnabled="{Binding HasSessions}"
                    ItemsSource="{Binding Sessions}"
                    SelectedItem="{Binding SelectedSession, Mode=TwoWay}" />
                <ComboBox
                    x:Uid="LogsViewSelector"
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding ViewOptions}"
                    SelectedItem="{Binding SelectedView, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource TranslationLogViewModeDisplayConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button
                    x:Uid="LogsRefreshButton"
                    Grid.Row="1"
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock x:Uid="LogsRefreshButtonText" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Spacing="8">
            <InfoBar
                x:Uid="LogsError"
                AutomationProperties.LiveSetting="Assertive"
                IsClosable="False"
                IsOpen="{Binding HasError}"
                Message="{Binding ErrorMessage}"
                Severity="Error" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="LogsDirectoryLabel" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    x:Uid="LogsDirectoryPath"
                    Grid.Column="1"
                    IsTextSelectionEnabled="True"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{Binding LogDirectoryPath}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </StackPanel>

        <Grid Grid.Row="3">
            <TextBox
                x:Uid="LogsContent"
                AcceptsReturn="True"
                HorizontalAlignment="Stretch"
                IsReadOnly="True"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Style="{ThemeResource MonospaceTextBoxStyle}"
                Text="{Binding LogText, Mode=OneWay}"
                TextWrapping="NoWrap"
                VerticalAlignment="Stretch"
                Visibility="{Binding HasLogText, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <StackPanel
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10"
                Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                <FontIcon FontSize="32" Glyph="&#xE7BA;" />
                <TextBlock
                    x:Uid="LogsEmptyTitle"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{ThemeResource SectionTitleStyle}"
                    TextAlignment="Center" />
                <TextBlock
                    x:Uid="LogsEmptyBody"
                    TextAlignment="Center"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>

            <Border
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressRing
                    x:Uid="LogsBusy"
                    Width="40"
                    Height="40"
                    HorizontalAlignment="Center"
                    IsActive="{Binding IsLoading}"
                    VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Grid>
</Page>
