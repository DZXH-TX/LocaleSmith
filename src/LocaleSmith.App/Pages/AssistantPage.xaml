<Page
    x:Class="LocaleSmith.App.Pages.AssistantPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:LocaleSmith.App.Behaviors"
    NavigationCacheMode="Required">
    <Grid Padding="24" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Uid="AssistantTitle" Style="{ThemeResource PageTitleStyle}" />
                <TextBlock x:Uid="AssistantSubtitle" TextWrapping="WrapWholeWords" />
            </StackPanel>
            <StackPanel Grid.Column="1" Width="320" Spacing="8">
                <ComboBox
                    x:Uid="AssistantProjectSelector"
                    ItemsSource="{Binding Projects}"
                    SelectedValue="{Binding SelectedProjectSelectionId, Mode=TwoWay}"
                    SelectedValuePath="SelectionId">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" />
                                <TextBlock
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{Binding DetailText}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox
                    x:Uid="AssistantModelSelector"
                    ItemsSource="{Binding ModelSources}"
                    SelectedValue="{Binding SelectedModelSourceId, Mode=TwoWay}"
                    SelectedValuePath="Id">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" />
                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}">
                                    <Run Text="{Binding ProviderName}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding ModelName}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar
                x:Uid="AssistantToolBoundary"
                behaviors:AppMotion.StatusFeedback="True"
                IsOpen="True"
                IsClosable="False"
                Severity="Warning" />
            <Border
                Padding="14"
                Style="{ThemeResource CardBorderStyle}"
                Visibility="{Binding HasSelectedProject, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Uid="AssistantActiveProjectLabel"
                            Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding ActiveProjectTitle}"
                            Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    </Grid>
                    <TextBlock
                        Grid.Row="1"
                        Text="{Binding ActiveProjectSummary}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Grid.Row="2"
                        Text="{Binding ActiveProjectObjective}"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Grid.Row="3"
                        Text="{Binding ActiveProjectConfiguration}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        TextWrapping="WrapWholeWords" />
                    <ProgressBar
                        Grid.Row="4"
                        Maximum="1"
                        Value="{Binding ActiveProjectProgress}" />
                    <TextBlock
                        Grid.Row="5"
                        Text="{Binding ActiveProjectUsageSummary}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        TextWrapping="WrapWholeWords"
                        Visibility="{Binding HasActiveProjectUsage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Border>
            <InfoBar
                x:Uid="AssistantError"
                behaviors:AppMotion.StatusFeedback="True"
                IsOpen="{Binding HasError}"
                IsClosable="False"
                Message="{Binding ErrorMessage}"
                Severity="Error" />
            <InfoBar
                x:Uid="AssistantStatus"
                behaviors:AppMotion.StatusFeedback="True"
                IsOpen="{Binding HasStatus}"
                IsClosable="False"
                Message="{Binding StatusMessage}"
                Severity="Informational" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Border Style="{ThemeResource CardBorderStyle}" Padding="8">
                <ListView
                    x:Name="ConversationList"
                    x:Uid="AssistantConversationList"
                    ItemsSource="{Binding Messages}"
                    SelectionMode="None"
                    IsItemClickEnabled="False"
                    AutomationProperties.LiveSetting="Polite">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="8,6"
                                Padding="16,12"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel Spacing="6">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Text="{Binding RoleLabel}"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <ProgressRing
                                            Grid.Column="1"
                                            Width="18"
                                            Height="18"
                                            IsActive="{Binding IsRunning}"
                                            Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                    <StackPanel
                                        Spacing="6"
                                        Visibility="{Binding HasActivities, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock
                                            x:Uid="AssistantProcessLabel"
                                            Style="{ThemeResource CaptionTextBlockStyle}" />
                                        <ItemsControl ItemsSource="{Binding Activities}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2" ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon
                                                            FontSize="13"
                                                            Glyph="{Binding Glyph}"
                                                            VerticalAlignment="Top" />
                                                        <StackPanel Grid.Column="1" Spacing="1">
                                                            <TextBlock
                                                                Text="{Binding Title}"
                                                                TextWrapping="WrapWholeWords" />
                                                            <TextBlock
                                                                Text="{Binding Detail}"
                                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                                TextWrapping="WrapWholeWords" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <TextBlock
                                        Text="{Binding Content}"
                                        IsTextSelectionEnabled="True"
                                        TextWrapping="WrapWholeWords"
                                        Visibility="{Binding HasContent, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Border
                                        Margin="0,4,0,0"
                                        Padding="10"
                                        Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                        CornerRadius="6"
                                        Visibility="{Binding HasTaskStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel DataContext="{Binding TaskStatus}" Spacing="5">
                                            <TextBlock
                                                Text="{Binding Title}"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <TextBlock
                                                Text="{Binding Summary}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                TextWrapping="WrapWholeWords" />
                                            <TextBlock
                                                Text="{Binding Objective}"
                                                TextWrapping="WrapWholeWords" />
                                            <TextBlock
                                                Text="{Binding ConfigurationSummary}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                TextWrapping="WrapWholeWords" />
                                            <ProgressBar
                                                AutomationProperties.Name="{Binding Title}"
                                                Maximum="1"
                                                Value="{Binding Progress}" />
                                            <TextBlock
                                                FontFamily="Consolas"
                                                IsTextSelectionEnabled="True"
                                                Text="{Binding TaskIdText}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        Margin="0,4,0,0"
                                        Padding="10,6"
                                        Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                        CornerRadius="6"
                                        Visibility="{Binding HasUsage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock
                                            Text="{Binding UsageSummary}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            TextWrapping="WrapWholeWords" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <StackPanel
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10"
                Visibility="{Binding IsConversationEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <FontIcon Glyph="&#xE99A;" FontSize="32" />
                <TextBlock
                    x:Uid="AssistantEmptyTitle"
                    Style="{ThemeResource SectionTitleStyle}"
                    TextAlignment="Center" />
                <TextBlock
                    x:Uid="AssistantEmptyBody"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Style="{ThemeResource CardBorderStyle}" Padding="16">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox
                    x:Uid="AssistantDraft"
                    AcceptsReturn="True"
                    MinHeight="96"
                    Text="{Binding Draft, Mode=TwoWay}"
                    TextWrapping="Wrap" />
                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{ThemeResource CaptionTextBlockStyle}">
                            <Run Text="{Binding DraftLength}" />
                            <Run x:Uid="AssistantLengthSuffix" />
                        </TextBlock>
                        <CheckBox
                            x:Uid="AssistantAllowProjectChanges"
                            IsChecked="{Binding AllowProjectChanges, Mode=TwoWay}"
                            Visibility="{Binding HasSelectedProject, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        x:Uid="AssistantClearButton"
                        Command="{Binding ClearCommand}" />
                    <Button
                        Grid.Column="2"
                        x:Uid="AssistantCancelButton"
                        Command="{Binding CancelCommand}" />
                    <Button
                        Grid.Column="3"
                        x:Uid="AssistantSendButton"
                        behaviors:AppMotion.ButtonFeedback="True"
                        Command="{Binding SendCommand}"
                        Style="{ThemeResource AccentButtonStyle}">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Enter" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
