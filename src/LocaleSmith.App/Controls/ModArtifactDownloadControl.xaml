<UserControl
    x:Class="LocaleSmith.App.Controls.ModArtifactDownloadControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Padding="12"
        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
        CornerRadius="8"
        Visibility="{Binding HasArtifact, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel Spacing="8">
            <TextBlock
                x:Uid="CommunityDownloadTitle"
                AutomationProperties.HeadingLevel="Level3"
                Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <TextBlock
                Text="{Binding Filename}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis" />
            <Button
                x:Uid="CommunityDefaultDownloadButton"
                HorizontalAlignment="Stretch"
                Click="OnDefaultDownloadClicked"
                IsEnabled="{Binding CanStartDownload}" />
            <Button
                x:Uid="CommunityAcceleratedDownloadButton"
                HorizontalAlignment="Stretch"
                Click="OnAcceleratedDownloadClicked"
                IsEnabled="{Binding CanStartDownload}"
                Style="{ThemeResource AccentButtonStyle}"
                Visibility="{Binding IsAccelerationAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock
                x:Uid="CommunityAccelerationDisclosure"
                Style="{ThemeResource CaptionTextBlockStyle}"
                TextWrapping="WrapWholeWords"
                Visibility="{Binding IsAccelerationAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <ProgressBar
                x:Uid="CommunityDownloadProgress"
                AutomationProperties.LiveSetting="Polite"
                IsIndeterminate="False"
                Maximum="1"
                Minimum="0"
                Value="{Binding Progress}"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button
                x:Uid="CommunityCancelDownloadButton"
                HorizontalAlignment="Stretch"
                Click="OnCancelDownloadClicked"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <InfoBar
                x:Uid="CommunityDownloadErrorInfo"
                AutomationProperties.LiveSetting="Assertive"
                IsClosable="False"
                IsOpen="{Binding HasError}"
                Message="{Binding ErrorMessage}"
                Severity="Error" />
            <InfoBar
                x:Uid="CommunityDownloadStatusInfo"
                AutomationProperties.LiveSetting="Polite"
                IsClosable="False"
                IsOpen="{Binding HasStatus}"
                Message="{Binding StatusMessage}"
                Severity="Informational" />
        </StackPanel>
    </Border>
</UserControl>
