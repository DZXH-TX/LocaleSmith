<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(VisualStudioVersion)' == '' Or '$(VisualStudioVersion)' &lt; '15.0'">
    <VisualStudioVersion>15.0</VisualStudioVersion>
  </PropertyGroup>

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup>
    <WapProjPath Condition="'$(WapProjPath)' == ''">$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\</WapProjPath>
  </PropertyGroup>

  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.props" />

  <PropertyGroup>
    <ProjectGuid>{F1340923-02C7-45C0-8B35-CCB92AE72786}</ProjectGuid>
    <ProjectName>LocaleSmith</ProjectName>
    <TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <EntryPointProjectUniqueName>..\..\src\LocaleSmith.App\LocaleSmith.App.csproj</EntryPointProjectUniqueName>
    <Platforms>x64</Platforms>
    <PackageFlavor Condition="'$(PackageFlavor)' == ''">Development</PackageFlavor>
  </PropertyGroup>

  <ItemGroup>
    <AppxManifest Include="Package.dev.appxmanifest" Condition="'$(PackageFlavor)' == 'Development'" />
    <AppxManifest Include="Package.appxmanifest" Condition="'$(PackageFlavor)' == 'Store'" />
    <ProjectReference Include="..\..\src\LocaleSmith.App\LocaleSmith.App.csproj">
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <PublishProfile>Properties\PublishProfiles\win-x64.pubxml</PublishProfile>
    </ProjectReference>
    <ProjectReference Include="..\..\src\LocaleSmith.McpHost\LocaleSmith.McpHost.csproj">
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <PublishProfile>Properties\PublishProfiles\win-x64.pubxml</PublishProfile>
    </ProjectReference>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1">
      <IncludeAssets>build</IncludeAssets>
    </PackageReference>
    <PRIResource Include="Strings\zh-CN\Resources.resw" />
    <PRIResource Include="Strings\en-US\Resources.resw" />
    <PRIResource Include="Strings\ja-JP\Resources.resw" />
    <PRIResource Include="Strings\fr-FR\Resources.resw" />
    <PRIResource Include="Strings\ru-RU\Resources.resw" />
    <Content Include="Assets\Square44x44Logo.png" />
    <Content Include="Assets\Square150x150Logo.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.png" />
  </ItemGroup>

  <Target Name="ValidateReleaseBrandAssets" BeforeTargets="PrepareForBuild">
    <Error
      Condition="'$(PackageFlavor)' != 'Development' And '$(PackageFlavor)' != 'Store'"
      Text="PackageFlavor must be Development or Store." />
    <Error
      Condition="!Exists('Assets\Square44x44Logo.png') Or !Exists('Assets\Square150x150Logo.png') Or !Exists('Assets\StoreLogo.png') Or !Exists('Assets\Wide310x150Logo.png')"
      Text="Approved MSIX PNG assets are missing. See packaging/README.md; placeholder images are not permitted." />
  </Target>

  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.targets" />
</Project>
